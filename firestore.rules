rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminPath(uid) {
      return /databases/$(database)/documents/adminUsers/$(uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(adminPath(request.auth.uid))
        && get(adminPath(request.auth.uid)).data.active == true;
    }

    function hasOnlyAllowedKeys(allowedKeys) {
      return request.resource.data.keys().hasOnly(allowedKeys);
    }

    function hasRequiredKeys(requiredKeys) {
      return request.resource.data.keys().hasAll(requiredKeys);
    }

    function validAdminUser() {
      return hasOnlyAllowedKeys(['active', 'email', 'role', 'displayName', 'createdAt', 'updatedAt'])
        && hasRequiredKeys(['active', 'email', 'role'])
        && request.resource.data.active is bool
        && request.resource.data.email is string
        && request.resource.data.role is string;
    }

    function legacyGiftProduct(productId) {
      return productId in [
        'calabash-gifts-set',
        'calabash-gift-set',
        'spa-day-gift-set',
        'erotic-gift-set'
      ];
    }

    function validProduct(productId) {
      return hasOnlyAllowedKeys([
          'category',
          'createdAt',
          'info',
          'info1',
          'info2',
          'inStock',
          'isActive',
          'isHighlighted',
          'photos',
          'priceOptions',
          'published',
          'shipping',
          'slug',
          'sortOrder',
          'title',
          'updatedAt',
          'variants'
        ])
        && hasRequiredKeys(['category', 'inStock', 'isActive', 'photos', 'priceOptions', 'published', 'shipping', 'title'])
        && request.resource.data.category is string
        && approvedProductCategory(request.resource.data.category)
        && (request.resource.data.category != 'gifts' || legacyGiftProduct(productId))
        && exists(/databases/$(database)/documents/productCategories/$(request.resource.data.category))
        && request.resource.data.published is bool
        && request.resource.data.inStock is bool
        && request.resource.data.isActive is bool
        && request.resource.data.photos is list
        && request.resource.data.priceOptions is list
        && request.resource.data.shipping is string
        && request.resource.data.title is string
        && (!('variants' in request.resource.data) || validProductVariants(request.resource.data.variants));
    }

    function validProductCategory() {
      return hasOnlyAllowedKeys(['active', 'createdAt', 'name', 'sortOrder', 'updatedAt'])
        && hasRequiredKeys(['active', 'name'])
        && request.resource.data.active is bool
        && request.resource.data.name is string
        && (!('sortOrder' in request.resource.data) || request.resource.data.sortOrder is number || request.resource.data.sortOrder == null)
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }

    function validProductVariant(variant) {
      return variant is map
        && variant.keys().hasOnly([
          'active',
          'id',
          'inventoryTracked',
          'label',
          'lowStockThreshold',
          'price',
          'priceOptionIndex',
          'sku',
          'sortOrder',
          'stockOnHand'
        ])
        && variant.keys().hasAll(['active', 'id', 'inventoryTracked', 'label', 'price', 'sku', 'stockOnHand'])
        && variant.active is bool
        && variant.id is string
        && variant.id.size() > 0
        && variant.id.size() <= 120
        && variant.inventoryTracked is bool
        && variant.label is string
        && variant.label.size() <= 160
        && variant.price is string
        && variant.price.size() <= 40
        && variant.sku is string
        && variant.sku.size() <= 120
        && variant.stockOnHand is int
        && variant.stockOnHand >= 0
        && (!('lowStockThreshold' in variant) || variant.lowStockThreshold == null || (variant.lowStockThreshold is int && variant.lowStockThreshold >= 0))
        && (!('priceOptionIndex' in variant) || variant.priceOptionIndex is int)
        && (!('sortOrder' in variant) || variant.sortOrder is int);
    }

    function validOptionalProductVariant(variants, index) {
      return variants.size() <= index || validProductVariant(variants[index]);
    }

    function validProductVariants(variants) {
      return variants is list
        && variants.size() <= 20
        && validOptionalProductVariant(variants, 0)
        && validOptionalProductVariant(variants, 1)
        && validOptionalProductVariant(variants, 2)
        && validOptionalProductVariant(variants, 3)
        && validOptionalProductVariant(variants, 4)
        && validOptionalProductVariant(variants, 5)
        && validOptionalProductVariant(variants, 6)
        && validOptionalProductVariant(variants, 7)
        && validOptionalProductVariant(variants, 8)
        && validOptionalProductVariant(variants, 9)
        && validOptionalProductVariant(variants, 10)
        && validOptionalProductVariant(variants, 11)
        && validOptionalProductVariant(variants, 12)
        && validOptionalProductVariant(variants, 13)
        && validOptionalProductVariant(variants, 14)
        && validOptionalProductVariant(variants, 15)
        && validOptionalProductVariant(variants, 16)
        && validOptionalProductVariant(variants, 17)
        && validOptionalProductVariant(variants, 18)
        && validOptionalProductVariant(variants, 19);
    }

    function approvedProductCategory(categoryId) {
      return categoryId in [
        'body-care',
        'culinary',
        'gifts',
        'loose-leaf-tea',
        'mambo-gede',
        'ritual-smoking-blends',
        'saffron',
        'tinctures'
      ];
    }

    function validDescriptionBlock(block) {
      return block is map
        && block.keys().hasOnly(['body', 'subtitle'])
        && (!('body' in block) || block.body is string)
        && (!('subtitle' in block) || block.subtitle is string);
    }

    function validOptionalDescriptionBlock(blocks, index) {
      return blocks.size() <= index || validDescriptionBlock(blocks[index]);
    }

    function validDescriptionBlocks(blocks) {
      return blocks is list
        && blocks.size() <= 20
        && validOptionalDescriptionBlock(blocks, 0)
        && validOptionalDescriptionBlock(blocks, 1)
        && validOptionalDescriptionBlock(blocks, 2)
        && validOptionalDescriptionBlock(blocks, 3)
        && validOptionalDescriptionBlock(blocks, 4)
        && validOptionalDescriptionBlock(blocks, 5)
        && validOptionalDescriptionBlock(blocks, 6)
        && validOptionalDescriptionBlock(blocks, 7)
        && validOptionalDescriptionBlock(blocks, 8)
        && validOptionalDescriptionBlock(blocks, 9)
        && validOptionalDescriptionBlock(blocks, 10)
        && validOptionalDescriptionBlock(blocks, 11)
        && validOptionalDescriptionBlock(blocks, 12)
        && validOptionalDescriptionBlock(blocks, 13)
        && validOptionalDescriptionBlock(blocks, 14)
        && validOptionalDescriptionBlock(blocks, 15)
        && validOptionalDescriptionBlock(blocks, 16)
        && validOptionalDescriptionBlock(blocks, 17)
        && validOptionalDescriptionBlock(blocks, 18)
        && validOptionalDescriptionBlock(blocks, 19);
    }

    function validEventTicketCounts() {
      return (!('capacity' in request.resource.data) || (request.resource.data.capacity is int && request.resource.data.capacity >= 0))
        && (!('manualSeatsReserved' in request.resource.data) || (request.resource.data.manualSeatsReserved is int && request.resource.data.manualSeatsReserved >= 0))
        && (!('ticketsSold' in request.resource.data) || (request.resource.data.ticketsSold is int && request.resource.data.ticketsSold >= 0))
        && (!('manualSeatsReserved' in request.resource.data) || ('capacity' in request.resource.data))
        && (!('ticketsSold' in request.resource.data) || ('capacity' in request.resource.data))
        && (!('manualSeatsReserved' in request.resource.data) || request.resource.data.manualSeatsReserved <= request.resource.data.capacity)
        && (!('ticketsSold' in request.resource.data) || request.resource.data.ticketsSold <= request.resource.data.capacity)
        && (!('manualSeatsReserved' in request.resource.data && 'ticketsSold' in request.resource.data) || request.resource.data.manualSeatsReserved + request.resource.data.ticketsSold <= request.resource.data.capacity);
    }

    function validEvent() {
      return hasOnlyAllowedKeys([
          'capacity',
          'category',
          'childTicket',
          'createdAt',
          'date',
          'descriptionBlocks',
          'dietaryOptions',
          'eventDates',
          'info',
          'inStock',
          'isActive',
          'link',
          'manualSeatsReserved',
          'photos',
          'priceOptions',
          'published',
          'shipping',
          'slug',
          'ticketsSold',
          'title',
          'updatedAt',
          'waitlistEnabled'
        ])
        && hasRequiredKeys(['category', 'date', 'eventDates', 'info', 'inStock', 'isActive', 'photos', 'priceOptions', 'published', 'shipping', 'title'])
        && request.resource.data.eventDates is list
        && request.resource.data.category is string
        && request.resource.data.date is timestamp
        && (!('descriptionBlocks' in request.resource.data) || validDescriptionBlocks(request.resource.data.descriptionBlocks))
        && request.resource.data.info is list
        && request.resource.data.inStock is bool
        && request.resource.data.isActive is bool
        && request.resource.data.photos is list
        && request.resource.data.priceOptions is list
        && request.resource.data.published is bool
        && request.resource.data.shipping is string
        && request.resource.data.title is string
        && validEventTicketCounts()
        && (!('waitlistEnabled' in request.resource.data) || request.resource.data.waitlistEnabled is bool);
    }

    function validInventoryMovement() {
      return hasOnlyAllowedKeys([
          'capacityGroupKey',
          'createdAt',
          'createdBy',
          'lineItemId',
          'linkedId',
          'linkedType',
          'orderId',
          'quantityDelta',
          'reason',
          'sku',
          'source',
          'sourcePaymentId',
          'title',
          'variantId'
        ])
        && hasRequiredKeys(['createdAt', 'createdBy', 'linkedId', 'linkedType', 'quantityDelta', 'reason', 'source', 'title'])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.linkedId is string
        && request.resource.data.linkedId.size() > 0
        && request.resource.data.linkedType in ['product', 'event']
        && request.resource.data.quantityDelta is int
        && request.resource.data.reason in ['sale', 'refund', 'manual_adjustment', 'square_import', 'comp', 'waste']
        && request.resource.data.source in ['paypal_web', 'square_pos', 'square_import', 'manual', 'inventory_adjustment']
        && request.resource.data.title is string
        && (!('capacityGroupKey' in request.resource.data) || request.resource.data.capacityGroupKey is string)
        && (!('lineItemId' in request.resource.data) || request.resource.data.lineItemId is string)
        && (!('orderId' in request.resource.data) || request.resource.data.orderId is string)
        && (!('sku' in request.resource.data) || request.resource.data.sku is string)
        && (!('sourcePaymentId' in request.resource.data) || request.resource.data.sourcePaymentId is string)
        && (!('variantId' in request.resource.data) || request.resource.data.variantId is string);
    }

    function validAdminInventoryMovement() {
      return validInventoryMovement()
        && request.resource.data.createdBy == 'admin_inventory'
        && request.resource.data.reason == 'manual_adjustment'
        && request.resource.data.source == 'manual'
        && (!('orderId' in request.resource.data) || request.resource.data.orderId == '')
        && (!('sourcePaymentId' in request.resource.data) || request.resource.data.sourcePaymentId == '');
    }

    function validSiteContent() {
      return hasOnlyAllowedKeys(['createdAt', 'published', 'sections', 'sortOrder', 'updatedAt'])
        && hasRequiredKeys(['published', 'sections'])
        && request.resource.data.published is bool
        && (request.resource.data.sections is map || request.resource.data.sections is list);
    }

    function validDraftStatus(status) {
      return status in ['draft', 'published', 'discarded'];
    }

    function validDraftMetadata(targetCollection, targetId) {
      return request.resource.data.draftStatus is string
        && validDraftStatus(request.resource.data.draftStatus)
        && request.resource.data.draftTargetCollection == targetCollection
        && request.resource.data.draftTargetId == targetId
        && request.resource.data.draftUpdatedAt is timestamp
        && request.resource.data.draftUpdatedBy is string
        && (!('draftPublishedAt' in request.resource.data) || request.resource.data.draftPublishedAt is timestamp)
        && (!('draftPublishedBy' in request.resource.data) || request.resource.data.draftPublishedBy is string)
        && (!('draftDiscardedAt' in request.resource.data) || request.resource.data.draftDiscardedAt is timestamp)
        && (!('draftDiscardedBy' in request.resource.data) || request.resource.data.draftDiscardedBy is string);
    }

    function validProductDraft(productId) {
      return hasOnlyAllowedKeys([
          'category',
          'createdAt',
          'draftDiscardedAt',
          'draftDiscardedBy',
          'draftPublishedAt',
          'draftPublishedBy',
          'draftStatus',
          'draftTargetCollection',
          'draftTargetId',
          'draftUpdatedAt',
          'draftUpdatedBy',
          'info',
          'info1',
          'info2',
          'inStock',
          'isActive',
          'isHighlighted',
          'photos',
          'priceOptions',
          'published',
          'shipping',
          'slug',
          'sortOrder',
          'title',
          'updatedAt',
          'variants'
        ])
        && hasRequiredKeys(['category', 'draftStatus', 'draftTargetCollection', 'draftTargetId', 'draftUpdatedAt', 'draftUpdatedBy', 'inStock', 'isActive', 'photos', 'priceOptions', 'published', 'shipping', 'title'])
        && validDraftMetadata('products', productId)
        && request.resource.data.category is string
        && approvedProductCategory(request.resource.data.category)
        && (request.resource.data.category != 'gifts' || legacyGiftProduct(productId))
        && exists(/databases/$(database)/documents/productCategories/$(request.resource.data.category))
        && request.resource.data.published is bool
        && request.resource.data.inStock is bool
        && request.resource.data.isActive is bool
        && request.resource.data.photos is list
        && request.resource.data.priceOptions is list
        && request.resource.data.shipping is string
        && request.resource.data.title is string
        && (!('variants' in request.resource.data) || validProductVariants(request.resource.data.variants));
    }

    function validEventDraft(eventId) {
      return hasOnlyAllowedKeys([
          'capacity',
          'category',
          'childTicket',
          'createdAt',
          'date',
          'descriptionBlocks',
          'dietaryOptions',
          'draftDiscardedAt',
          'draftDiscardedBy',
          'draftPublishedAt',
          'draftPublishedBy',
          'draftStatus',
          'draftTargetCollection',
          'draftTargetId',
          'draftUpdatedAt',
          'draftUpdatedBy',
          'eventDates',
          'info',
          'inStock',
          'isActive',
          'link',
          'manualSeatsReserved',
          'photos',
          'priceOptions',
          'published',
          'shipping',
          'slug',
          'ticketsSold',
          'title',
          'updatedAt',
          'waitlistEnabled'
        ])
        && hasRequiredKeys(['category', 'date', 'draftStatus', 'draftTargetCollection', 'draftTargetId', 'draftUpdatedAt', 'draftUpdatedBy', 'eventDates', 'info', 'inStock', 'isActive', 'photos', 'priceOptions', 'published', 'shipping', 'title'])
        && validDraftMetadata('events', eventId)
        && request.resource.data.eventDates is list
        && request.resource.data.category is string
        && request.resource.data.date is timestamp
        && (!('descriptionBlocks' in request.resource.data) || validDescriptionBlocks(request.resource.data.descriptionBlocks))
        && request.resource.data.info is list
        && request.resource.data.inStock is bool
        && request.resource.data.isActive is bool
        && request.resource.data.photos is list
        && request.resource.data.priceOptions is list
        && request.resource.data.published is bool
        && request.resource.data.shipping is string
        && request.resource.data.title is string
        && validEventTicketCounts()
        && (!('waitlistEnabled' in request.resource.data) || request.resource.data.waitlistEnabled is bool);
    }

    function validEventWaitlistEntry() {
      return hasOnlyAllowedKeys(['createdAt', 'email', 'eventDate', 'eventId', 'eventTitle', 'message', 'name', 'phone', 'status'])
        && hasRequiredKeys(['createdAt', 'email', 'eventDate', 'eventId', 'eventTitle', 'name', 'status'])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 180
        && request.resource.data.eventDate is string
        && request.resource.data.eventDate.size() > 0
        && request.resource.data.eventDate.size() <= 160
        && request.resource.data.eventId is string
        && request.resource.data.eventId.size() > 0
        && request.resource.data.eventId.size() <= 180
        && request.resource.data.eventTitle is string
        && request.resource.data.eventTitle.size() > 0
        && request.resource.data.eventTitle.size() <= 240
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.status == 'new'
        && (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 1000))
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 80));
    }

    function waitlistEventPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }

    function waitlistTicketsSold(event) {
      return ('ticketsSold' in event) ? event.ticketsSold : 0;
    }

    function waitlistManualSeatsReserved(event) {
      return ('manualSeatsReserved' in event) ? event.manualSeatsReserved : 0;
    }

    function validWaitlistTarget(event) {
      return event.keys().hasAll(['capacity', 'date', 'eventDates', 'isActive', 'published', 'title', 'waitlistEnabled'])
        && event.capacity is int
        && event.capacity > 0
        && event.date is timestamp
        && event.date > request.time
        && event.eventDates is list
        && event.isActive == true
        && event.published == true
        && event.title is string
        && event.waitlistEnabled == true
        && (!('ticketsSold' in event) || (event.ticketsSold is int && event.ticketsSold >= 0))
        && (!('manualSeatsReserved' in event) || (event.manualSeatsReserved is int && event.manualSeatsReserved >= 0))
        && waitlistTicketsSold(event) + waitlistManualSeatsReserved(event) >= event.capacity
        && request.resource.data.eventTitle == event.title
        && request.resource.data.eventDate in event.eventDates;
    }

    function validSiteContentDraft(contentId) {
      return hasOnlyAllowedKeys([
          'createdAt',
          'draftDiscardedAt',
          'draftDiscardedBy',
          'draftPublishedAt',
          'draftPublishedBy',
          'draftStatus',
          'draftTargetCollection',
          'draftTargetId',
          'draftUpdatedAt',
          'draftUpdatedBy',
          'published',
          'sections',
          'sortOrder',
          'updatedAt'
        ])
        && hasRequiredKeys(['draftStatus', 'draftTargetCollection', 'draftTargetId', 'draftUpdatedAt', 'draftUpdatedBy', 'published', 'sections'])
        && validDraftMetadata('siteContent', contentId)
        && request.resource.data.published is bool
        && (request.resource.data.sections is map || request.resource.data.sections is list);
    }

    function validInventory() {
      return hasOnlyAllowedKeys(['createdAt', 'dietaryVariant', 'eventDate', 'linkedId', 'linkedType', 'notes', 'stock', 'updatedAt'])
        && hasRequiredKeys(['linkedId', 'linkedType', 'stock'])
        && request.resource.data.linkedId is string
        && request.resource.data.linkedType is string
        && request.resource.data.stock is number;
    }

    function validMediaBin(bin) {
      return bin in ['products', 'events', 'site', 'other'];
    }

    function validMediaStatus(status) {
      return status in ['active', 'archived'];
    }

    function validMediaLinkedType(linkedType) {
      return linkedType in ['product', 'event', 'site', 'none'];
    }

    function validMediaAsset() {
      return hasOnlyAllowedKeys([
          'alt',
          'bin',
          'contentType',
          'createdAt',
          'linkedId',
          'linkedType',
          'migratedAt',
          'size',
          'source',
          'sourcePath',
          'status',
          'storagePath',
          'tags',
          'title',
          'updatedAt',
          'uploadedBy'
        ])
        && hasRequiredKeys(['alt', 'bin', 'linkedId', 'linkedType', 'status', 'storagePath', 'tags', 'title'])
        && request.resource.data.alt is string
        && request.resource.data.bin is string
        && validMediaBin(request.resource.data.bin)
        && request.resource.data.linkedId is string
        && request.resource.data.linkedType is string
        && validMediaLinkedType(request.resource.data.linkedType)
        && request.resource.data.status is string
        && validMediaStatus(request.resource.data.status)
        && request.resource.data.storagePath is string
        && request.resource.data.tags is list
        && request.resource.data.title is string
        && (!('contentType' in request.resource.data) || request.resource.data.contentType is string)
        && (!('size' in request.resource.data) || request.resource.data.size is number || request.resource.data.size == null)
        && (!('source' in request.resource.data) || request.resource.data.source is string)
        && (!('sourcePath' in request.resource.data) || request.resource.data.sourcePath is string)
        && (!('uploadedBy' in request.resource.data) || request.resource.data.uploadedBy is string)
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp)
        && (!('migratedAt' in request.resource.data) || request.resource.data.migratedAt is timestamp)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }

    match /adminUsers/{userId} {
      allow get: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validAdminUser();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && validProduct(productId);
      allow delete: if isAdmin();
    }

    match /productDrafts/{productId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && validProductDraft(productId);
      allow delete: if isAdmin();
    }

    match /productCategories/{categoryId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && approvedProductCategory(categoryId) && validProductCategory();
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && validEvent();
      allow delete: if isAdmin();
    }

    match /eventWaitlist/{entryId} {
      allow create: if validEventWaitlistEntry()
        && exists(waitlistEventPath(request.resource.data.eventId))
        && validWaitlistTarget(get(waitlistEventPath(request.resource.data.eventId)).data);
      allow get, list, update, delete: if isAdmin();
    }

    match /eventDrafts/{eventId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && validEventDraft(eventId);
      allow delete: if isAdmin();
    }

    match /siteContent/{contentId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && validSiteContent();
      allow delete: if isAdmin();
    }

    match /siteContentDrafts/{contentId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && validSiteContentDraft(contentId);
      allow delete: if isAdmin();
    }

    match /inventory/{inventoryId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && validInventory();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /paypalCheckouts/{checkoutId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /paypalWebhookEvents/{eventId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /paymentReferences/{referenceId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /inventoryMovements/{movementId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && validAdminInventoryMovement();
      allow update, delete: if false;
    }

    match /mediaAssets/{mediaAssetId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && validMediaAsset();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
